---
/*
 * Brand logo. The site has a single light palette, so this is always the
 * blue lockup. The white lockup is still in /public for use on dark
 * material elsewhere (slides, merch); nothing on the site references it.
 *
 * The two brand assets are different shapes, so we constrain height and
 * let width flow.
 */
interface Props {
  height?: number;
  loading?: 'eager' | 'lazy';
  class?: string;
}
const { height = 18, loading = 'eager', class: cls } = Astro.props;
---

<img
  class:list={['logo', cls]}
  src="/logo-blue.png"
  alt="Nova Consulting"
  loading={loading}
  decoding="async"
  style={`height:${height}px`}
/>

<style>
  .logo {
    display: block;
    width: auto;
  }
</style>
