---
/*
 * Site footer. Logo, contact email, socials, copyright. Reused on every
 * page.
 *
 * The email and the social links come from src/config.ts. Any of them
 * that is UNSET is simply not rendered, rather than guessed at.
 */
import Logo from './Logo.astro';
import { site, social, isSet } from '../config';

const year = new Date().getFullYear();
const socials = [
  { href: social.instagram, label: 'Instagram' },
  { href: social.linkedin, label: 'LinkedIn' },
].filter((s) => isSet(s.href));
---

<footer class="footer">
  <Logo height={18} loading="lazy" />
  {
    isSet(site.email) && (
      <a href={`mailto:${site.email}`} class="footer-email">
        {site.email}
      </a>
    )
  }
  {
    socials.length > 0 && (
      <div class="footer-socials">
        {socials.map((s) => (
          <a href={s.href} rel="me">
            {s.label}
          </a>
        ))}
      </div>
    )
  }
  <div class="footer-legal">© {year} {site.name} · UC Berkeley</div>
</footer>

<style>
  .footer {
    border-top: var(--hairline) solid var(--rule);
    padding: 24px 16px;
  }
  .footer-email {
    display: block;
    margin-top: 16px;
    margin-bottom: 14px;
    font-size: 14px;
    color: var(--ink);
  }
  .footer-email:hover {
    color: var(--accent);
  }
  .footer-socials {
    display: flex;
    gap: 20px;
    margin-bottom: 16px;
  }
  .footer-socials a {
    font-family: var(--font-display);
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .footer-legal {
    font-family: var(--font-display);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
    margin-top: 16px;
  }
  @media (min-width: 720px) {
    .footer {
      padding: 32px 28px;
    }
  }
</style>
