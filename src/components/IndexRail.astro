---
/*
 * The signature left-hand index rail: a top section number, a rotated
 * vertical label, and a bottom section number. Purely decorative, so it
 * is hidden from assistive tech.
 */
interface Props {
  label: string;
  top?: string;
  bottom: string;
}
const { label, top = '01', bottom } = Astro.props;
---

<div class="rail" aria-hidden="true">
  <span class="rail-num">{top}</span>
  <span class="rail-label">{label}</span>
  <span class="rail-num">{bottom}</span>
</div>

<style>
  .rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 14px 0;
    border-right: var(--hairline) solid var(--rule);
    font-family: var(--font-display);
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--accent);
  }
  .rail-label {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    letter-spacing: 0.24em;
    color: var(--client);
    white-space: nowrap;
  }
  @media (min-width: 720px) {
    .rail {
      padding: 22px 0;
      font-size: 12px;
    }
    .rail-label {
      letter-spacing: 0.3em;
    }
  }
</style>
