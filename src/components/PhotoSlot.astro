---
/*
 * A photograph slot with the brand's navy wash over it.
 *
 * ⚠ The wash is a TINT, not a scrim. It ties a photo into the palette;
 * it does not make the photo safe to put text on. Measured against the
 * current hero images, the site's navy ink over the washed shadows
 * reaches only 1.2:1, far below the 4.5:1 that AA asks for.
 *
 * Nothing on the site puts text over a photo today, so nothing fails.
 * If you ever want to, the tint is not enough: a band that carries text
 * needs a real scrim that lightens the image, tuned against that
 * specific photo. Do not just move text on top of this.
 *
 * Honest-empty by default: with no `src` this renders NOTHING, so an
 * unfilled slot costs the page nothing rather than showing an obviously
 * empty grey box. Pass `placeholder` to get the diagonal stripe texture
 * instead (used inside cards, where the slot is part of the shape).
 *
 * To fill one: drop the image into /public and paste its path into the
 * matching field — page copy for hero bands, team.yaml for headshots,
 * a project's `image` for case-study cards. Nothing else changes.
 */
interface Props {
  src?: string;
  alt?: string;
  /** CSS aspect-ratio, e.g. "21 / 9". */
  ratio?: string;
  /** Navy tint over the image, tying it into the palette. Not a scrim:
      see the contrast note at the top of this file. */
  wash?: boolean;
  /** Show the stripe texture when there is no image, instead of nothing. */
  placeholder?: boolean;
  class?: string;
}
const {
  src,
  alt = '',
  ratio = '21 / 9',
  wash = true,
  placeholder = false,
  class: cls,
} = Astro.props;

const hasPhoto = typeof src === 'string' && src.trim() !== '';
---

{
  hasPhoto ? (
    <div
      class:list={['pslot', { wash }, cls]}
      style={`--pslot-ratio:${ratio}`}
    >
      <img src={src} alt={alt} loading="lazy" decoding="async" />
    </div>
  ) : placeholder ? (
    <div
      class:list={['pslot', 'is-empty', 'stripe', cls]}
      style={`--pslot-ratio:${ratio}`}
      aria-hidden="true"
    />
  ) : null
}

<style>
  .pslot {
    position: relative;
    aspect-ratio: var(--pslot-ratio);
    overflow: hidden;
    background: var(--panel);
  }
  .pslot img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* The navy wash: a flat tint plus a deeper gradient at the foot, so
     the band sits inside the page rather than punching a hole in it.
     Decorative only — see the note at the top of this file. */
  .pslot.wash::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, transparent 40%, var(--overlay) 100%),
      var(--overlay);
  }
  .pslot.is-empty {
    background-color: var(--panel);
  }
</style>
