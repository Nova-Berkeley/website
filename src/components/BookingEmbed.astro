---
/*
 * Coffee-chat booking embed.
 *
 * Set the embed URL in ONE place: `bookingEmbedUrl` in src/config.ts.
 * Any booking tool works — Airtable, Calendly, Google Forms — paste its
 * embed link and the calendar appears here.
 *
 * While the URL is UNSET we render an honest "booking opens soon" panel
 * rather than an empty frame or a spinner that never resolves. Once set,
 * the <iframe> loads lazily behind a branded loading state that fades
 * out on the frame's `load` event.
 */
import { bookingEmbedUrl, isSet } from '../config';
import EmptyState from './EmptyState.astro';

interface Props {
  loadingText: string;
  unsetHeading: string;
  unsetBody: string;
  title?: string;
}
const {
  loadingText,
  unsetHeading,
  unsetBody,
  title = 'Coffee chat booking form',
} = Astro.props;

const configured = isSet(bookingEmbedUrl);
---

{
  configured ? (
    <div class="embed">
      <div class="embed-loading" data-loading>
        <div class="embed-spinner" aria-hidden="true" />
        <div class="embed-loading-text">{loadingText}</div>
        <div class="embed-skeleton" aria-hidden="true">
          <span />
          <span />
          <span />
        </div>
      </div>
      <iframe
        class="embed-frame"
        src={bookingEmbedUrl}
        title={title}
        loading="lazy"
        referrerpolicy="no-referrer"
      />
    </div>
  ) : (
    <EmptyState heading={unsetHeading} body={unsetBody} />
  )
}

<script>
  document.querySelectorAll<HTMLElement>('.embed').forEach((box) => {
    const frame = box.querySelector('iframe');
    const loading = box.querySelector<HTMLElement>('[data-loading]');
    if (!frame || !loading) return;
    frame.addEventListener('load', () => {
      loading.style.opacity = '0';
      loading.addEventListener(
        'transitionend',
        () => (loading.style.display = 'none'),
        { once: true }
      );
    });
  });
</script>

<style>
  .embed {
    position: relative;
    height: 600px;
    border: var(--hairline) solid var(--rule);
    background: var(--panel);
    overflow: hidden;
  }
  .embed-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .embed-loading {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    padding: 24px;
    background: var(--panel);
    transition: opacity 0.4s ease;
  }
  .embed-spinner {
    width: 42px;
    height: 42px;
    border: 3px solid var(--rule);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: embed-spin 0.9s linear infinite;
  }
  .embed-loading-text {
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .embed-skeleton {
    width: 100%;
    max-width: 240px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .embed-skeleton span {
    height: 12px;
    background: var(--rule);
    animation: embed-pulse 1.4s ease-in-out infinite;
  }
  .embed-skeleton span:nth-child(2) {
    width: 80%;
    animation-delay: 0.2s;
  }
  .embed-skeleton span:nth-child(3) {
    width: 60%;
    animation-delay: 0.4s;
  }
  @keyframes embed-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes embed-pulse {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 0.8;
    }
  }

</style>
