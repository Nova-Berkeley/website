---
/*
 * Project / case-study card. `variant`:
 *   featured — the big text-forward case study (problem + headline metric)
 *   lead     — larger grid card with an image slot
 *   small    — compact grid card
 * When no image is set, the media slot shows the client name instead
 * (matching the comps' "no photo" state).
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>['data'];
  variant: 'featured' | 'lead' | 'small';
}
const { project, variant } = Astro.props;
---

{
  variant === 'featured' ? (
    <div class="pf">
      <div class="pf-head">
        <h3 class="pf-client">{project.client}</h3>
        <span class="pf-sem">{project.semester}</span>
      </div>
      <div class="pf-body">
        <p class="pf-label">The problem</p>
        <p class="pf-problem prose">{project.problem}</p>
        <div class="pf-metric-row">
          <div class="pf-metric">{project.metric}</div>
          <div class="pf-metric-label" set:html={(project.metricLabel ?? '').replace(/\n/g, '<br>')} />
        </div>
      </div>
    </div>
  ) : (
    <article class:list={['pc', `v-${variant}`]}>
      <div class="pc-media">
        {project.image ? (
          <img src={project.image} alt={`${project.client} project`} loading="lazy" />
        ) : (
          <span class="pc-media-client">{project.client}</span>
        )}
      </div>
      <div class="pc-body">
        <div class="pc-row">
          <span class="pc-client">{project.client}</span>
          <span class="pc-sem">{project.semester}</span>
        </div>
        <p class="pc-outcome">{project.outcome}</p>
      </div>
    </article>
  )
}

<style>
  /* ---- Featured ---- */
  .pf {
    border: var(--hairline) solid var(--rule);
    background: var(--panel);
  }
  .pf-head {
    padding: 18px 16px;
    border-bottom: var(--hairline) solid var(--rule);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
  }
  .pf-client {
    font-size: 28px;
    text-transform: uppercase;
    line-height: 1;
  }
  .pf-sem {
    flex: 0 0 auto;
    font-family: var(--font-display);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--accent);
    text-transform: uppercase;
  }
  .pf-body {
    padding: 18px 16px;
  }
  .pf-label {
    font-family: var(--font-display);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--accent);
    text-transform: uppercase;
    margin: 0 0 8px;
  }
  .pf-problem {
    font-size: 15px;
    line-height: 1.45;
    color: var(--ink);
    margin: 0 0 22px;
  }
  .pf-metric-row {
    border-top: var(--hairline) solid var(--rule-soft);
    padding-top: 18px;
    display: flex;
    align-items: flex-end;
    gap: 16px;
  }
  .pf-metric {
    font-family: var(--font-display);
    font-size: 84px;
    line-height: 0.8;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .pf-metric-label {
    font-family: var(--font-display);
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--accent);
    text-transform: uppercase;
    padding-bottom: 12px;
  }

  /* ---- Grid cards ---- */
  .pc {
    border: var(--hairline) solid var(--rule);
    background: var(--panel);
  }
  .pc-media {
    border-bottom: var(--hairline) solid var(--rule);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    position: relative;
  }
  .v-lead .pc-media {
    height: 190px;
    padding: 16px;
  }
  .v-small .pc-media {
    height: 96px;
    padding: 10px;
  }
  .pc-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pc-media-client {
    font-family: var(--font-display);
    text-transform: uppercase;
    color: var(--ink);
    line-height: 1.05;
  }
  .v-lead .pc-media-client {
    font-size: 34px;
  }
  .v-small .pc-media-client {
    font-size: 17px;
  }
  .pc-body {
    padding: 12px;
  }
  .v-lead .pc-body {
    padding: 16px;
  }
  .pc-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
  }
  .pc-client {
    font-family: var(--font-display);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--accent);
    text-transform: uppercase;
  }
  .v-lead .pc-client {
    font-size: 13px;
    letter-spacing: 0.14em;
  }
  .pc-sem {
    flex: 0 0 auto;
    font-family: var(--font-display);
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--dim);
    text-transform: uppercase;
  }
  .pc-outcome {
    margin: 8px 0 0;
    font-family: var(--font-display);
    line-height: 1.3;
  }
  .v-lead .pc-outcome {
    font-size: 18px;
  }
  .v-small .pc-outcome {
    font-size: 13px;
  }
</style>
